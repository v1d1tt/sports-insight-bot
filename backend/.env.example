# Copy this file to backend/.env (git-ignored) and fill in your key.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Without it the API uses google/gemma-4-26b-a4b-it.
# The free variant is fine for local work (it has lower rate limits).
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
